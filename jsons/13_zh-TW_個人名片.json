  },
  "footer": {
    "type": "box",
    "layout": "horizontal",
    "spacing": "sm",
    "paddingAll": "lg",
    "flex": 0,
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "color": "#06C755",
        "flex": 1,
        "action": {
